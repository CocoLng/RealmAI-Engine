# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/

# --- Virtual environments ---
.venv/

# --- uv ---
.python-version

# --- Environment variables ---
.env
.env.*
!.env.example

# --- Tool caches ---
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Local game data (dev) ---
# SQLite + ChromaDB live under data/ at dev time; campaigns are reseedable
# via scripts/reset_dev_data.py, so this directory is never checked in.
data/

# --- Generic DB / sqlite (safety net for stray files elsewhere) ---
*.db
*.sqlite
*.sqlite3

# --- Runtime artifacts ---
# Bot runtime logs at the repo root only — tasks/logs/ holds versioned
# live-test artifacts (C8 smoke & co) and must stay tracked.
/logs/

# --- OS ---
.DS_Store
Thumbs.db

# --- Git worktrees ---
.worktrees/

# --- Claude Code local state ---
# .claude/skills, .claude/settings.json, .mcp.json ARE checked in — they
# encode shared project configuration. Per-user / per-session state is not.
.claude/projects/
.claude/worktrees/
.claude/settings.local.json

# Simulation run artifacts (transcripts, reports, per-run DBs)
tests/simulation/runs/
