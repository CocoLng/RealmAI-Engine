# Discord bot token (from Developer Portal → Bot → Reset Token)
DISCORD_BOT_TOKEN=

# --- Testing infrastructure (optional) ---
# Set TEST_MODE=true to enable the TestBridge cog
TEST_MODE=false
# Tester bot token (separate Discord application for automated testing)
TESTER_BOT_TOKEN=
# Tester bot's Discord user ID (for TestBridge authorization)
TESTER_BOT_ID=
# Channel ID to run tests in
TEST_CHANNEL_ID=
# Game bot's Discord user ID (for response filtering)
GAME_BOT_ID=
